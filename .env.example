# LLM provider configuration (required for live mode, not needed for unit tests)
# Harness reads ROUTER_LLM_* env vars and maps them to ChatOpenAI parameters.
ROUTER_LLM_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ROUTER_LLM_API_KEY=sk-placeholder-replace-with-real-key
ROUTER_LLM_MODEL=qwen3.6-flash-2026-04-16
ROUTER_LLM_TEMPERATURE=0
ROUTER_LLM_TIMEOUT_SECONDS=30
ROUTER_LLM_ENABLE_THINKING=false

# Optional: workflow server URL for E2E testing
# WORKFLOW_SERVER_URL=http://127.0.0.1:9877
