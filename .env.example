# LLM provider configuration (required for live mode, not needed for mock/test)
# The deepagent SDK uses langchain_openai (ChatOpenAI), which reads these
# standard OpenAI SDK environment variables:
OPENAI_API_BASE=https://api.siliconflow.cn/v1
OPENAI_API_KEY=sk-placeholder-replace-with-real-key

# Optional: workflow server URL for E2E testing
# WORKFLOW_SERVER_URL=http://127.0.0.1:9877
