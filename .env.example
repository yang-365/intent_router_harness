# LLM provider configuration (required for live mode, not needed for mock/test)
ROUTER_LLM_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ROUTER_LLM_API_KEY=sk-placeholder-replace-with-real-key
ROUTER_LLM_MODEL=qwen-plus
ROUTER_LLM_TIMEOUT_SECONDS=120

# Optional: thinking/reasoning model controls
# ROUTER_LLM_ENABLE_THINKING=true
# ROUTER_LLM_THINKING_BUDGET=4096

# Optional: workflow server URL for E2E testing
# WORKFLOW_SERVER_URL=http://127.0.0.1:9876
